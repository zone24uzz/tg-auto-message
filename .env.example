# Telegram API sozlamalari (https://my.telegram.org dan olinadi)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Telegram Session String (Birinchi marta bo'sh qoldiring, dastur kod beradi va saqlaydi)
TELEGRAM_SESSION=

# Google Gemini API Kaliti (https://aistudio.google.com dan olinadi)
GEMINI_API_KEY=AIzaSy...

# Gemini Modeli (gemini-2.0-flash yoki gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Tarixdan olinadigan xabarlar soni (standart: 50)
HISTORY_LIMIT=50

# Xabarlarni birlashtirib javob berish kutish vaqti (millisekundda, masalan 4000 = 4 soniya)
DEBOUNCE_MS=4000

# AI javob berishdan oldin "typing..." ko'rsatish (true/false)
SIMULATE_TYPING=true

# AI javob bermasligi kerak bo'lgan Telegram username yoki ID'lar (vergul bilan ajratilgan)
BLACKLIST_USERS=

# MongoDB URI (Render'da qayta ishga tushganda sozlamalar saqlanib qolishi uchun)
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/tg-auto-message?retryWrites=true&w=majority

# Admin Boti uchun sozlamalar (Admin Boshqaruv Panelini yoqish uchun)
BOT_TOKEN=123456789:AA...
ADMIN_ID=
ADMIN_PASSWORD=komron2026

